# Local-only Image Gateway relay template
# Copy to .env.local for normal local web/dev use.
# Copy to .env.desktop.local instead if you only want the route available in desktop mode.

VITE_IMAGE_GATEWAY_ENABLED=true
VITE_IMAGE_GATEWAY_PATH=/api/image/generate

# Local email auth.
# Leave RESEND_API_KEY empty to show a local-only verification code in the auth form.
# Fill RESEND_API_KEY to test real email delivery through Resend.
AUTH_EMAIL_FROM=Superpower <noreply@example.com>
APP_PUBLIC_ORIGIN=http://127.0.0.1:4175
AUTH_LEGACY_AUTH_ENABLED=false
AUTH_DEV_EMAIL_CODE_ENABLED=true
RESEND_API_KEY=
AUTH_CODE_PEPPER=local-dev-auth-code-pepper-change-me

# Optional operator token for POST /api/image/gateway/routes/override
# Keep this server-side only. Do not expose it as any VITE_* variable.
IMAGE_GATEWAY_ADMIN_TOKEN=replace-with-a-long-random-token

# Recommended route naming and priority convention:
# - Route 1: primary route, normally the preferred default
# - Route 2: first fallback route
# - Route 3: second fallback route
# Lower PRIORITY number wins during normal selection.
# Keep fallback routes disabled until they pass both:
# 1) npm run gateway:routes:preflight -- --include-disabled
# 2) one real low-cost gateway smoke with quality=low and n=1.
# A /models 200 only means ready_for_smoke; it does not prove image-generation balance/quota.

IMAGE_GATEWAY_ROUTE_1_BASE_URL=https://your-relay.example.com/v1
IMAGE_GATEWAY_ROUTE_1_API_KEY=your-relay-key
IMAGE_GATEWAY_ROUTE_1_MODEL=gpt-image-2
IMAGE_GATEWAY_ROUTE_1_NAME=Primary Relay Route
IMAGE_GATEWAY_ROUTE_1_ENABLED=true
IMAGE_GATEWAY_ROUTE_1_DISABLED_REASON=
IMAGE_GATEWAY_ROUTE_1_PRIORITY=1
IMAGE_GATEWAY_ROUTE_1_WEIGHT=1
IMAGE_GATEWAY_ROUTE_1_TIMEOUT_SECONDS=180
IMAGE_GATEWAY_ROUTE_1_INITIAL_LATENCY_MS=30000
IMAGE_GATEWAY_ROUTE_1_EXHAUSTED_COOLDOWN_SECONDS=21600
IMAGE_GATEWAY_ROUTE_1_MAX_CONCURRENCY=2
IMAGE_GATEWAY_ROUTE_1_SUPPORTS_EDIT=true
IMAGE_GATEWAY_ROUTE_1_SUPPORTS_MASK=true
IMAGE_GATEWAY_ROUTE_1_SUPPORTS_STREAMING=false
IMAGE_GATEWAY_ROUTE_1_COMPATIBILITY=relay_extended

IMAGE_GATEWAY_ROUTE_2_BASE_URL=https://your-fallback-relay.example.com/v1
IMAGE_GATEWAY_ROUTE_2_API_KEY=your-fallback-relay-key
IMAGE_GATEWAY_ROUTE_2_MODEL=gpt-image-2
IMAGE_GATEWAY_ROUTE_2_NAME=First Fallback Relay Route
IMAGE_GATEWAY_ROUTE_2_ENABLED=false
IMAGE_GATEWAY_ROUTE_2_DISABLED_REASON=Enable only after preflight and one successful low-cost real smoke.
IMAGE_GATEWAY_ROUTE_2_PRIORITY=2
IMAGE_GATEWAY_ROUTE_2_WEIGHT=1
IMAGE_GATEWAY_ROUTE_2_TIMEOUT_SECONDS=180
IMAGE_GATEWAY_ROUTE_2_INITIAL_LATENCY_MS=30000
IMAGE_GATEWAY_ROUTE_2_EXHAUSTED_COOLDOWN_SECONDS=21600
IMAGE_GATEWAY_ROUTE_2_MAX_CONCURRENCY=2
IMAGE_GATEWAY_ROUTE_2_SUPPORTS_EDIT=true
IMAGE_GATEWAY_ROUTE_2_SUPPORTS_MASK=true
IMAGE_GATEWAY_ROUTE_2_SUPPORTS_STREAMING=false
IMAGE_GATEWAY_ROUTE_2_COMPATIBILITY=relay_extended

IMAGE_GATEWAY_ROUTE_3_BASE_URL=https://your-second-fallback-relay.example.com/v1
IMAGE_GATEWAY_ROUTE_3_API_KEY=your-second-fallback-relay-key
IMAGE_GATEWAY_ROUTE_3_MODEL=gpt-image-2
IMAGE_GATEWAY_ROUTE_3_NAME=Second Fallback Relay Route
IMAGE_GATEWAY_ROUTE_3_ENABLED=false
IMAGE_GATEWAY_ROUTE_3_DISABLED_REASON=Enable only after preflight and one successful low-cost real smoke.
IMAGE_GATEWAY_ROUTE_3_PRIORITY=3
IMAGE_GATEWAY_ROUTE_3_WEIGHT=1
IMAGE_GATEWAY_ROUTE_3_TIMEOUT_SECONDS=180
IMAGE_GATEWAY_ROUTE_3_INITIAL_LATENCY_MS=30000
IMAGE_GATEWAY_ROUTE_3_EXHAUSTED_COOLDOWN_SECONDS=21600
IMAGE_GATEWAY_ROUTE_3_MAX_CONCURRENCY=2
IMAGE_GATEWAY_ROUTE_3_SUPPORTS_EDIT=true
IMAGE_GATEWAY_ROUTE_3_SUPPORTS_MASK=true
IMAGE_GATEWAY_ROUTE_3_SUPPORTS_STREAMING=false
IMAGE_GATEWAY_ROUTE_3_COMPATIBILITY=relay_extended
